# Copy to ~/.myna/.env (gitignored). Configure ONE IM provider per machine —
# telegram | discord | slack. If several are configured, MYNA_PROVIDER picks the active one
# (unset = first configured, in the order telegram → discord → slack).
# MYNA_PROVIDER=telegram

# --- telegram (Node 18+) -------------------------------------------------------
# One Telegram bot PER MACHINE (create via @BotFather).
TELEGRAM_BOT_TOKEN=
# The chat Myna uses is bound with /myna:pair (one-time code sent from that chat; kept in
# ~/.myna/telegram-chat.json). Setting it here instead still works; a paired chat wins over it.
# Only that chat may answer — a group works too, and every member of it may answer.
# TELEGRAM_CHAT_ID=
# Topics: auto (default) = one topic per Claude session when the bot has "Threaded Mode" enabled in
# @BotFather (Bot Settings); falls back to the flat chat when it doesn't. off = always flat.
# TELEGRAM_TOPICS=auto
# Topic scope: gate (default) = one topic per decision gate (ask_human `gate`; intercepted AskUserQuestion
#   = one gate); it ends when the session moves to another gate, when Claude finishes its reply (Stop hook),
#   or when the session ends. session = one topic per Claude session, ended only at session end (pre-0.8).
# TELEGRAM_TOPIC_SCOPE=gate
# Seconds between "Claude finished its reply" and ending the gate's topic; an ask within it keeps the topic.
# TELEGRAM_TOPIC_ROUND_GRACE=600
# What to do with a topic when it ends (gate over / session ends):
#   delete (default) = remove the topic and its messages (the list never piles up; decisions are in MYNA-DECISIONS.jsonl)
#   close = mark it ended, stays in the list (private chats can't close topics → renamed with a 🔒 prefix)
#   keep = leave it untouched
# TELEGRAM_TOPIC_ON_END=delete

# --- discord (Node 22+, built-in WebSocket) ------------------------------------
# Bot token from the Discord Developer Portal (Bot page). No privileged intents needed.
# DISCORD_BOT_TOKEN=
# Text channel the bot posts gates to (Developer Mode → right-click channel → Copy Channel ID).
# DISCORD_CHANNEL_ID=

# --- slack (Node 22+, built-in WebSocket) --------------------------------------
# Bot token (xoxb-…, scope chat:write) + Socket Mode app-level token (xapp-…, connections:write).
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# Channel the bot posts gates to (invite the bot, then channel details → Copy Channel ID).
# SLACK_CHANNEL_ID=

# Permission forwarding (/myna:perm): seconds a permission dialog waits for the terminal before it
# also goes to the phone (0 = right away).
# MYNA_PERMISSION_DELAY=30

# Chat sessions (Telegram): at most one progress-message edit per this many ms per session.
# MYNA_CHAT_PROGRESS_MS=3000
# Chat default for new sessions (otherwise on for terminal / VS Code, off for -p / SDK),
# and a fixed nickname instead of a bird. /myna:chat on|off and /myna:nick override per session.
# MYNA_CHAT=on
# MYNA_CHAT_NICK=robin

# Several machines, one bot (0.20.0 — README "多台機器共用一支 bot", SPEC §5.1).
# HUB (the machine whose bot is the one inbox): open the port other machines' relays reach through a
# tunnel (Cloudflare Tunnel → http://127.0.0.1:7801; never point a tunnel at 7800).
# MYNA_REMOTE_PORT=7801
# MYNA_MACHINE_NAME=win
# MYNA_TOPIC_MACHINE=auto
# EDGE (every other machine): /myna:join writes the first two and the token file. A bot of its own
# (keys above) stays as the fallback while the hub is away — never the hub's own bot (same bot id).
# MYNA_ROLE=edge
# MYNA_UPSTREAM=https://myna.example.com
# MYNA_CF_ACCESS_CLIENT_ID=
# MYNA_CF_ACCESS_CLIENT_SECRET=
# MYNA_UPSTREAM_GRACE=120
# MYNA_UPSTREAM_RECOVER=3

# optional overrides
# MYNA_RELAY_URL=http://127.0.0.1:7800
# RELAY_PORT=7800
# Connection attempt timeout (ms) per address when the relay connects to Telegram / Discord / Slack.
# Node tries IPv6 and IPv4 in turn and gives each only 250ms by default; on a network where IPv6 goes
# nowhere and the IPv4 handshake is slow, every call failed with "fetch failed". The relay sets 2000 at
# start (relay only — your shell and other Node programs are not touched). 0 / negative / not a number
# → 2000. The value in effect shows in relay.log's start line and in GET /health (net_attempt_ms).
# MYNA_NET_ATTEMPT_MS=2000
# Session handoff (detach_human / await_human): seconds a handed-off question waits for another session
# to take it over before it is cancelled like a normal end (covers the gap between hand-off and
# take-over — a session restarted after a crash takes ~10 min worst case; 30 min = 3× that).
# MYNA_DETACH_TTL=1800
# Approval attestation (ask_human `approves` + POST /attest): how long (ms) a ✅ tap on the phone stays
# usable to let its one command through a guard. Not a positive number → 900000 (15 min).
# MYNA_APPROVAL_TTL_MS=900000
